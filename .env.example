# Mapa geral de variáveis de ambiente do Lastro.
#
# Cada módulo tem o seu próprio .env (src/backend/.env, src/db/ingestao/.env,
# src/frontend/.env) — este arquivo na raiz é só o inventário de tudo que o
# sistema completo usa, para quem está subindo o ambiente pela primeira vez.
# Copie os blocos que precisar para o .env.example de cada módulo.

# ============================================================
# Neo4j AuraDB — banco de grafo (backend + ingestão)
# ============================================================
NEO4J_URI=neo4j+s://xxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ============================================================
# Backend (src/backend) — FastAPI
# ============================================================
# Origens autorizadas a chamar a API (CORS). Separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Porta do servidor. Render/Railway/Fly injetam $PORT e a ignoram se fixa.
PORT=8000

# ============================================================
# Ingestão (src/db/ingestao) — pipeline de enriquecimento da carteira
# ============================================================
# Reusa NEO4J_* acima. Reusa também o .env do backend se existir, então
# normalmente não precisa duplicar credencial aqui.
# Caminho da carteira que filtra todas as fontes (padrão: ./carteira.csv)
LASTRO_CARTEIRA=
# Trimestre da PGFN a baixar (padrão: 2026_trimestre_02)
LASTRO_PGFN_TRIMESTRE=
# Quantos anos de INMET baixar para o baseline de chuva (padrão: 5)
LASTRO_INMET_ANOS=
# User-Agent para as fontes públicas (Receita/IBAMA/INMET/Conab recusam UA vazio)
LASTRO_USER_AGENT=
# Timeout HTTP em segundos (padrão: 180)
LASTRO_HTTP_TIMEOUT=
# Chave pública do DataJud/CNJ (já tem default público no código; só
# sobrescreva se o CNJ rotacionar a chave)
DATAJUD_APIKEY=

# ============================================================
# Frontend (src/frontend) — Vite/React
# ============================================================
# URL pública do backend FastAPI.
VITE_API_URL=http://localhost:8000
# Deixe comentado/ausente para usar a API real (padrão). Só `true` força os
# dados sintéticos do case Krilltech, ignorando o backend.
# VITE_DEMO_MODE=true

# ============================================================
# watsonx Orchestrate / IBM Cloud — integração de agentes de IA
# ============================================================
# O MVP do hackathon integra os 4 agentes por IMPORT MANUAL de OpenAPI na
# console do watsonx Orchestrate (ver .ai/docs/watsonx-orchestrate-setup.md) —
# nenhuma dessas variáveis é lida pelo código hoje. Elas documentam o que uma
# integração PROGRAMÁTICA (via ADK/API do watsonx Orchestrate, para operação
# real e não apenas demo) precisaria em produção.
WATSONX_APIKEY=
WATSONX_URL=https://api.<regiao>.watsonx-orchestrate.cloud.ibm.com
WATSONX_ORCHESTRATE_INSTANCE_ID=
IBM_CLOUD_API_KEY=
IBM_CLOUD_REGION=us-south
