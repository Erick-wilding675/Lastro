# URL do backend FastAPI. Em produção, a URL pública da API.
VITE_API_URL=http://localhost:8000

# Deixe comentado/ausente para usar a API real (padrão).
# Só `true` força os dados sintéticos do case KRILLTECH, ignorando o backend.
# Se a API cair, a tela já cai sozinha na reserva sintética e avisa no topo —
# não é preciso ligar isto para ter rede de proteção no pitch.
# VITE_DEMO_MODE=true
